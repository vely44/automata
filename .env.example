# ZeroClaw Stack — Environment Variables
# ========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Discord bot token for ZeroClaw agent
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Discord bot token for Dashboard Bot
# (Can be the same as DISCORD_BOT_TOKEN if using one bot, or a separate token)
DASHBOT_TOKEN=your_dashbot_token_here

# ZeroClaw gateway port (default: 8080)
ZEROCLAW_PORT=8080

# LLM API keys — set at least one depending on your provider in config.toml
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
